# Copy to backend/.env and replace placeholders. Never commit real credentials.
MONGO_URL=mongodb://127.0.0.1:27018
DB_NAME=vaptx_local
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:8001
NMAP_BINARY=nmap
VAPTX_LOCAL_HTTP=1
# Optional: AI requests require the separate requirements-ai.txt and API key
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
