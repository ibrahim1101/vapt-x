# Copy to backend/.env and replace placeholders. Never commit real credentials.
MONGO_URL=mongodb://127.0.0.1:27018
DB_NAME=vaptx_local
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:8001
NMAP_BINARY=nmap
VAPTX_LOCAL_HTTP=1
# Optional AI providers: HTTP adapters use core httpx; keys stay server-side.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Bound database startup/readiness wait (100–30000 milliseconds)
MONGO_TIMEOUT_MS=5000

# Configure only providers you intend to use. Model lists may be comma-separated
# via OPENAI_MODELS / GEMINI_MODELS / OLLAMA_MODELS / OPENAI_COMPATIBLE_MODELS.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Explicit operator endpoints only. No localhost probing occurs unless configured.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# OpenAI-compatible base should include /v1 when required by the server.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Optional encrypted webhooks. Generate a Fernet key with cryptography.
# Comma-separated keys support rotation: first encrypts; all listed keys decrypt.
# Back up these keys separately. Losing them makes saved destinations unreadable.
WEBHOOK_ENCRYPTION_KEYS=

# Optional TOTP enrollment. Comma-separated Fernet keys: first encrypts; all decrypt.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep old keys during rotation and back them up securely. Recovery codes work without this key.
MFA_ENCRYPTION_KEYS=
